<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Your Site Name</title>
    <link href="/css/tailwind.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h2>Reset Password</h2>
        <form method="POST" action="/wiki/resetrequest/<%= resetToken %>">
            <div class="form-group">
                <label for="password" class="form-control-label">New Password</label>
                <input type="password" class="form-control<%= errors.password ? ' is-invalid' : '' %>" id="password" name="password" required>
                <% if (errors.password) { %>
                    <div class="invalid-feedback">
                        <%= errors.password.msg %>
                    </div>
                <% } %>
            </div>
            <div class="form-group">
                <label for="confirmPassword" class="form-control-label">Confirm New Password</label>
                <input type="password" class="form-control<%= errors.confirmPassword ? ' is-invalid' : '' %>" id="confirmPassword" name="confirmPassword" required>
                <% if (errors.confirmPassword) { %>
                    <div class="invalid-feedback">
                        <%= errors.confirmPassword.msg %>
                    </div>
                <% } %>
            </div>
            <button type="submit" class="btn btn-outline-info">Reset Password</button>
        </form>
    </div>
    </body>
</html>
