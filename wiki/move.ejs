<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Move <%= title.replace(/_/g, ' ') %> | Test Wiki | linkiowikis</title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="bg-black min-h-screen text-gray-900 font-sans m-0 p-0">
    <%- include('./partials/banner') %>
    <main class="w-full max-w-5xl mx-auto pt-20 pb-12 px-4">
        <%- include('./partials/addnewpage') %>
        <div class="bg-[#748a88] shadow-md">
            <%- include('./partials/header') %>
            <div class="bg-white min-h-[160px] p-6 shadow-sm">
                <h2 class="text-2xl font-medium text-black m-0 mb-4">Move <%= title.replace(/_/g, ' ') %></h2>
                <% if (error_msg.length > 0) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error_msg %>
                    </div>
                <% } %>
                <form action="/wiki/<%= title.replace(/\s/g, '_') %>/move" method="post" class="max-w-xl space-y-4">
                    <div class="form-group">
                        <label for="newTitle" class="block font-medium mb-1 text-sm">New Page Title:</label>
                        <input type="text" class="form-control" id="newTitle" name="newTitle" required>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="leaveRedirect" name="leaveRedirect" checked>
                        <label class="form-check-label" for="leaveRedirect">
                            Leave a redirect behind
                        </label>
                    </div>
                    <div class="form-group">
                        <label for="justification" class="block font-medium mb-1 text-sm">Justification:</label>
                        <input type="text" class="form-control" id="justification" name="justification">
                    </div>
                    <button type="submit" class="btn btn-primary btn-flat text-sm px-4 py-2">Move Page</button>
                </form>
            </div>
            <%- include('./partials/footer') %>
        </div>
    </main>
    <script src="/js/scripts.js"></script>
</body>
</html>
