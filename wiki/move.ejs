<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Move <%= title.replace(/_/g, ' ') %> | Test Wiki | linkiowikis</title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="d-flex h-100 bg-black">
    <div class="container d-flex w-100 h-100 mx-auto flex-column">
        <%- include('./partials/banner') %>
        <main role="main" class="container">    
            <div class="row d-flex justify-content-center mt-4">
                <div class="col-md-10 main p-0">
                    <%- include('./partials/addnewpage') %>
                    <%- include('./partials/header') %>
                    <div class="w-100 bg-white min-height-150 p-3 shadow-sm">
                        <h2 class="mb-0">Move <%= title.replace(/_/g, ' ') %></h2>
                        <% if (error_msg.length > 0) { %>
                            <div class="alert alert-danger" role="alert">
                                <%= error_msg %>
                            </div>
                        <% } %>
                        <form action="/wiki/<%= title.replace(/\s/g, '_') %>/move" method="post">
                            <div class="form-group">
                                <label for="newTitle">New Page Title:</label>
                                <input type="text" class="form-control" id="newTitle" name="newTitle" required>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="leaveRedirect" name="leaveRedirect" checked>
                                <label class="form-check-label" for="leaveRedirect">
                                    Leave a redirect behind
                                </label>
                            </div>
                            <div class="form-group">
                                <label for="justification">Justification:</label>
                                <input type="text" class="form-control" id="justification" name="justification">
                            </div>
                            <button type="submit" class="btn btn-primary btn-flat btn-sm">Move Page</button>
                        </form>
                    </div>
                    <%- include('./partials/footer') %>
                </div>
            </div>
        </main>
        <footer class="mt-auto text-white-50">
        </footer>
    </div>
    <script src="/js/scripts.js"></script>
</body>
</html> 