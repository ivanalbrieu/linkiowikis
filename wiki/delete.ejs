<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete <%= title.replace(/_/g, ' ') %> | Test Wiki | linkiowikis</title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="bg-black min-h-screen text-gray-900 font-sans m-0 p-0">
    <%- include('./partials/banner') %>
    <main class="w-full max-w-5xl mx-auto pt-20 pb-12 px-4">
        <%- include('./partials/addnewpage') %>
        <div class="bg-[#748a88] shadow-md">
            <%- include('./partials/header') %>
            <div class="bg-white min-h-[160px] p-6 shadow-sm">
                <h2 class="text-2xl font-medium text-black m-0 mb-4">Delete <%= title.replace(/_/g, ' ') %></h2>
                <div class="alert alert-warning" role="alert">
                    <strong>Warning: The page you are about to delete has a <a href="/wiki/<%= title %>/history" title="Page history">history with revisions</a>.</strong>
                </div>
                <form method="POST" action="/wiki/<%= encodeURIComponent(title) %>/delete" class="max-w-xl space-y-4">
                    <div class="form-group">
                        <label for="justification" class="block font-medium mb-1 text-sm">Justification:</label>
                        <input type="text" class="form-control" id="justification" name="justification">
                    </div>
                    <button type="submit" class="btn btn-danger btn-flat text-sm px-4 py-2">Delete Page</button>
                </form>
            </div>
            <%- include('./partials/footer') %>
        </div>
    </main>
    <script src="/js/scripts.js"></script>
</body>
</html>
