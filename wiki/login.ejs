<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Log In | Test Wiki | linkiowikis</title>
    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="d-flex h-100 bg-black">
    <div class="container d-flex w-100 h-100 mx-auto flex-column">
        <%- include('./partials/banner') %>
        <main role="main" class="container">    
            <div class="row d-flex justify-content-center mt-4">
                <div class="col-md-10 main p-0">
                    <%- include('./partials/addnewpage') %>
                    <%- include('./partials/header') %>
					<div class="w-100" style="background-color: white; min-height: 150px; padding: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
						<% if (error_msg.length > 0) { %>
						<div class="alert alert-danger" role="alert">
							<%= error_msg %>
						</div>
						<% } %>
						
						<% if (error.length > 0) { %>
						<div class="alert alert-danger" role="alert">
							<%= error %>
						</div>
						<% } %>
						
						<% if (success_msg.length > 0) { %>
						<div class="alert alert-success" role="alert">
							<%= success_msg %>
						</div>
						<% } %>							
						<form method="POST" action="/wiki/login"> <!-- Adjust the action URL as needed -->
							<fieldset class="form-group">
								<h2 class="mb-0">Log In</h2>
								<div class="form-group">
									<label for="username" class="form-control-label">Username</label>
									<input type="text" class="form-control form-control-lg" id="username" name="username" required>
									<div class="invalid-feedback">
										<%= errors.username ? errors.username.msg : '' %>
									</div>
								</div>
								<div class="form-group">
									<label for="password" class="form-control-label">Password</label>
									<input type="password" class="form-control form-control-lg" id="password" name="password" required>
									<div class="invalid-feedback">
										<%= errors.password ? errors.password.msg : '' %>
									</div>
								</div>
								<div class="form-check">
									<input type="checkbox" class="form-check-input" id="remember" name="remember">
									<label class="form-check-label" for="remember">Remember Me</label>
								</div>
							</fieldset>
							<div class="form-group">
								<button type="submit" class="btn btn-primary btn-flat btn-sm">Log In</button>
								<small class="text-muted ml-2">
									<a href="/wiki/resetrequest">Forgot Password?</a>
								</small>
							</div>
						</form>			
						<!-- Google login button -->
						<div class="text-center mt-3">
							<a href="/auth/google" class="btn btn-danger">Login with Google</a>
						</div>	
						<small class="text-muted">
							Need An Account? <a class="ml-2" href="/wiki/register">Sign Up Now</a>
					</small>					
					</div>
					<%- include('./partials/footer') %>
                </div>
            </div>
        </main>
    </div>
    <!-- Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/scripts.js"></script>
</body>
</html> 