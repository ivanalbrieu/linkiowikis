<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In | Test Wiki | linkiowikis</title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="bg-black min-h-screen text-gray-900 font-sans m-0 p-0">
    <%- include('./partials/banner') %>
    <main class="w-full max-w-5xl mx-auto pt-20 pb-12 px-4">
        <%- include('./partials/addnewpage') %>
        <div class="bg-[#748a88] shadow-md">
            <%- include('./partials/header') %>
            <div class="bg-white min-h-[160px] p-6 shadow-sm">
                <% if (error_msg.length > 0) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error_msg %>
                    </div>
                <% } %>
                
                <% if (error.length > 0) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                <% } %>
                
                <% if (success_msg.length > 0) { %>
                    <div class="alert alert-success" role="alert">
                        <%= success_msg %>
                    </div>
                <% } %>

                <div class="max-w-md mx-auto py-4">
                    <form method="POST" action="/wiki/login">
                        <h2 class="text-2xl font-medium text-black m-0 mb-4">Log In</h2>
                        <div class="form-group">
                            <label for="username" class="block font-medium mb-1 text-sm">Username</label>
                            <input type="text" class="form-control <%= errors.username ? 'is-invalid' : '' %>" id="username" name="username" required>
                            <% if (errors.username) { %>
                                <div class="invalid-feedback">
                                    <%= errors.username.msg %>
                                </div>
                            <% } %>
                        </div>
                        <div class="form-group">
                            <label for="password" class="block font-medium mb-1 text-sm">Password</label>
                            <input type="password" class="form-control <%= errors.password ? 'is-invalid' : '' %>" id="password" name="password" required>
                            <% if (errors.password) { %>
                                <div class="invalid-feedback">
                                    <%= errors.password.msg %>
                                </div>
                            <% } %>
                        </div>
                        <div class="form-check mb-4">
                            <input type="checkbox" class="form-check-input" id="remember" name="remember">
                            <label class="form-check-label" for="remember">Remember Me</label>
                        </div>
                        <div class="flex items-center gap-3">
                            <button type="submit" class="btn btn-primary btn-flat text-sm px-4 py-2">Log In</button>
                            <small class="text-muted">
                                <a class="text-blue-600 hover:underline" href="/wiki/resetrequest">Forgot Password?</a>
                            </small>
                        </div>
                    </form>

                    <!-- Google login button -->
                    <div class="text-center mt-6 pt-4 border-t border-gray-200">
                        <a href="/auth/google" class="btn btn-danger text-sm px-4 py-2">Login with Google</a>
                    </div>
                    
                    <div class="mt-4 text-center">
                        <small class="text-muted">
                            Need An Account? <a class="text-blue-600 hover:underline ml-1" href="/wiki/register">Sign Up Now</a>
                        </small>
                    </div>
                </div>
            </div>
            <%- include('./partials/footer') %>
        </div>
    </main>
    <script src="/js/scripts.js"></script>
</body>
</html>
