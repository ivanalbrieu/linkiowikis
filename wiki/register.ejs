<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | Test Wiki | linkiowikis</title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="d-flex h-100 bg-black">
    <div class="container d-flex w-100 h-100 mx-auto flex-column">
        <%- include('./partials/banner') %>
        <main role="main" class="container">    
            <div class="row d-flex justify-content-center mt-4">
                <div class="col-md-10 main p-0">
                    <%- include('./partials/addnewpage') %>
                    <%- include('./partials/header') %>
                    <div class="w-100" style="background-color: white; min-height: 150px; padding: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                        <% if (error_msg.length > 0) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error_msg %>
                        </div>
                        <% } %>
                        
                        <% if (error.length > 0) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error %>
                        </div>
                        <% } %>
                        
                        <% if (success_msg.length > 0) { %>
                        <div class="alert alert-success" role="alert">
                            <%= success_msg %>
                        </div>
                        <% } %>                            
                        <form method="POST" action="/wiki/register"> <!-- Adjust the action URL as needed -->
                            <fieldset class="form-group">
                                <h2 class="mb-0">Join <%= siteConfig.siteName %></h2>
                                <div class="form-group">
                                    <label for="username" class="form-control-label">Username</label>
                                    <input type="text" class="form-control form-control-lg" id="username" name="username" required>
                                    <div class="invalid-feedback">
                                        <%= errors.username ? errors.username.msg : '' %>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="email" class="form-control-label">Email</label>
                                    <input type="email" class="form-control form-control-lg" id="email" name="email" required>
                                    <div class="invalid-feedback">
                                        <%= errors.email ? errors.email.msg : '' %>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="password" class="form-control-label">Password</label>
                                    <input type="password" class="form-control form-control-lg" id="password" name="password" required>
                                    <div class="invalid-feedback">
                                        <%= errors.password ? errors.password.msg : '' %>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="confirm_password" class="form-control-label">Confirm Password</label>
                                    <input type="password" class="form-control form-control-lg" id="confirm_password" name="confirm_password" required>
                                    <div class="invalid-feedback">
                                        <%= errors.confirm_password ? errors.confirm_password.msg : '' %>
                                    </div>
                                </div>
                            </fieldset>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary btn-flat btn-sm">Sign Up</button>
                            </div>
                        </form>  
                        <!-- Google login button for registration page -->
                        <div class="text-center mt-3">
                            <a href="/auth/google" class="btn btn-danger">Register with Google</a>
                        </div>      
                        <small class="text-muted">
                            Already Have An Account? <a class="ml-2" href="/wiki/login">Sign In</a>
                        </small>               
                    </div>
                    <%- include('./partials/footer') %>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/scripts.js"></script>
</body>
</html> 