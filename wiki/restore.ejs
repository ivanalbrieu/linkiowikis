<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restore <%= title %> | <%= siteConfig.siteName %></title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="bg-black min-h-screen text-gray-900 font-sans m-0 p-0">
    <%- include('./partials/banner') %>
    <main class="w-full max-w-5xl mx-auto pt-20 pb-12 px-4">
        <%- include('./partials/addnewpage') %>
        <div class="bg-[#748a88] shadow-md">
            <%- include('./partials/header') %>
            <div class="bg-white min-h-[160px] p-6 shadow-sm">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-2xl font-medium text-black m-0">Restore Deleted Page: <%= title %></h2>
                    <a href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>" class="btn btn-primary btn-flat text-sm px-3 py-1">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>

                <div class="alert alert-info mb-4" role="alert">
                    <p class="m-0">This page was archived on <strong><%= formatDate(deletedPage.deleted_at) %></strong>. You can restore the full page or select specific revisions to recover.</p>
                </div>

                <% if (existingLivePage) { %>
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Notice:</strong> An active page titled "<%= title %>" currently exists on the wiki. Restoring archived revisions will append them to the existing page's history.
                    </div>
                <% } %>

                <% if (deletedRevisions && deletedRevisions.length > 0) { %>
                    <form method="POST" action="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/restore">
                        <div class="flex items-center gap-3 mb-4">
                            <button type="submit" name="restoreAll" value="true" class="btn btn-primary btn-flat text-sm px-4 py-2">
                                <i class="fa-solid fa-rotate-left"></i> Restore Entire Page (All Revisions)
                            </button>
                            <button type="submit" name="restoreAll" value="false" class="btn btn-secondary text-sm px-4 py-2">
                                Restore Selected Revisions
                            </button>
                        </div>

                        <div class="mb-2 text-sm text-gray-600 flex justify-between items-center">
                            <span>Available Archived Revisions (<%= deletedRevisions.length %> total):</span>
                            <button type="button" id="selectAllRevs" class="text-blue-600 hover:underline text-xs">Toggle Select All</button>
                        </div>

                        <table class="table">
                            <thead>
                                <tr>
                                    <th style="width: 40px;" class="text-center">Select</th>
                                    <th>Rev ID</th>
                                    <th>Edited By</th>
                                    <th>Date Edited</th>
                                    <th>Bytes</th>
                                    <th>Justification</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% deletedRevisions.forEach(function(rev) { %>
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" name="selectedRevisions" value="<%= rev.revisionId %>" checked class="form-check-input revision-checkbox">
                                        </td>
                                        <td>#<%= rev.revisionId %></td>
                                        <td><%= rev.editedBy || rev.edited_by || 'Anonymous' %></td>
                                        <td><%= formatDate(rev.editedAt || rev.edited_at) %></td>
                                        <td><%= rev.content ? Buffer.byteLength(rev.content, 'utf8') : 0 %> bytes</td>
                                        <td><%= rev.justification || '<span class="text-gray-400">None</span>' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>

                        <div class="mt-4">
                            <button type="submit" name="restoreAll" value="false" class="btn btn-secondary text-sm px-4 py-2">
                                Restore Selected Revisions
                            </button>
                        </div>
                    </form>
                <% } else { %>
                    <form method="POST" action="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/restore">
                        <p class="text-gray-700 mb-4">No individual revisions were archived, but the page content snapshot is preserved.</p>
                        <button type="submit" name="restoreAll" value="true" class="btn btn-primary btn-flat text-sm px-4 py-2">
                            <i class="fa-solid fa-rotate-left"></i> Restore Page Snapshot
                        </button>
                    </form>
                <% } %>

                <!-- Archive Retention & Flush Info (Admin) -->
                <% if (isAuthenticated) { %>
                    <div class="mt-8 pt-4 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-gray-500">
                        <div>
                            <span>Archival Retention Policy: Expired records are automatically purged by the background flush service after 30 days.</span>
                        </div>
                        <form method="POST" action="/wiki/admin/flush" onsubmit="return confirm('Permanently flush all archived records older than 30 days? This cannot be undone.');">
                            <button type="submit" class="btn btn-secondary text-xs px-2.5 py-1">
                                <i class="fa-solid fa-broom mr-1"></i> Flush Expired Archive Now
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
            <%- include('./partials/footer') %>
        </div>
    </main>
    <script src="/js/scripts.js"></script>
    <script>
        document.getElementById('selectAllRevs')?.addEventListener('click', function(e) {
            e.preventDefault();
            const checkboxes = document.querySelectorAll('.revision-checkbox');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            checkboxes.forEach(cb => cb.checked = !allChecked);
        });
    </script>
</body>
</html>
