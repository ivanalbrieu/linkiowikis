<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title.replace(/_/g, ' ') %>: Revision | Test Wiki | linkiowikis</title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="bg-black min-h-screen text-gray-900 font-sans m-0 p-0">
    <%- include('./partials/banner') %>
    <main class="w-full max-w-5xl mx-auto pt-20 pb-12 px-4">
        <%- include('./partials/addnewpage') %>
        <div class="bg-[#748a88] shadow-md">
            <%- include('./partials/header') %>
            <div class="bg-white min-h-[160px] p-6 shadow-sm">
                <div class="flex justify-between items-center mb-4">
                    <h1 class="text-2xl font-medium text-black m-0"><%= newRevision ? 'Changes: ' : '' %><%= title.replace(/_/g, ' ') %></h1>
                    <div>
                        <div class="relative dropdown">
                            <button class="btn btn-primary btn-flat text-sm px-3 py-1 flex items-center gap-1.5 dropdown-toggle" type="button" id="pageActionsMenu">
                                <i class="fa-solid fa-pencil"></i> Edit
                            </button>
                            <ul class="dropdown-menu right-0" aria-labelledby="pageActionsMenu">
                                <% if (newRevision) { %>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/edit?oldid=<%= newRevision.revisionId %>">Edit</a></li>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/history">History</a></li>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/purge?oldid=<%= oldRevision.revisionId %>&newid=<%= newRevision.revisionId %>">Purge</a></li>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>"><i class="fas fa-arrow-left"></i> Back to Page</a></li>
                                <% } else { %>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/edit?oldid=<%= oldRevision.revisionId %>">Edit</a></li>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/history">History</a></li>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/purge?oldid=<%= oldRevision.revisionId %>">Purge</a></li>
                                    <li><a class="dropdown-item" href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>"><i class="fas fa-arrow-left"></i> Back to Page</a></li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                </div>

                <% if (newRevision) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div>
                            <div class="alert alert-info" role="alert">
                                <a href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/diff?oldid=<%= oldRevision.revisionId %>">
                                    Viewing changes from <%= formatDate(oldRevision.editedAt) %> by <%= oldRevision.editedBy || 'Anonymous' %>
                                </a>
                            </div>
                            <% if (olderRevisionId) { %>
                                <div class="text-center mb-3">
                                    <a href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/diff?oldid=<%= olderRevisionId %>&newid=<%= oldRevision.revisionId %>" class="btn btn-primary btn-flat text-sm px-3 py-1">
                                        <i class="fas fa-arrow-left"></i> Older revision
                                    </a>
                                </div>
                            <% } %>
                            <% diffResult.forEach(function(part) { %>
                                <% if (part.removed) { %>
                                    <div class="bg-[#f8d7da] text-[#842029] p-2 rounded mb-2 font-mono text-sm whitespace-pre-wrap"><%= part.value %></div>
                                <% } %>
                            <% }); %>
                        </div>
                        <div>
                            <div class="alert alert-info" role="alert">
                                <a href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/diff?oldid=<%= newRevision.revisionId %>">
                                    Viewing changes up to <%= formatDate(newRevision.editedAt) %> by <%= newRevision.editedBy || 'Anonymous' %>
                                </a>
                            </div>
                            <% if (newerRevisionId) { %>
                                <div class="text-center mb-3">
                                    <a href="/wiki/<%= encodeURIComponent(title.replace(/\s/g, '_')) %>/diff?oldid=<%= newRevision ? newRevision.revisionId : oldRevision.revisionId %>&newid=<%= newerRevisionId %>" class="btn btn-primary btn-flat text-sm px-3 py-1">
                                        Newer revision <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            <% } %>
                            <% diffResult.forEach(function(part) { %>
                                <% if (part.added) { %>
                                    <div class="bg-[#d4edda] text-[#155724] p-2 rounded mb-2 font-mono text-sm whitespace-pre-wrap"><%= part.value %></div>
                                <% } %>
                            <% }); %>
                        </div>
                    </div>
                    <h3 class="text-xl font-medium mb-2">Latest revision as of <%= formatDate(newRevision.editedAt) %></h3>
                    <div class="wiki-rendered-content text-gray-900 leading-relaxed mb-4">
                        <%- newRevision.content %>
                    </div>
                    <%- include('partials/categoryselect', { categories: pageCategories, showAddCategoryButton: false }) %>
                <% } else { %>
                    <div class="alert alert-info" role="alert">
                        Revision as of <%= formatDate(oldRevision.editedAt) %> by <%= oldRevision.editedBy || 'Anonymous' %>
                    </div>
                    <div class="flex gap-2 mb-4">
                        <% if (olderRevisionId) { %>
                            <a href="/wiki/<%= title %>/diff?oldid=<%= olderRevisionId %>" class="btn btn-primary btn-flat text-sm px-3 py-1"><i class="fas fa-arrow-left"></i> Older revision</a>
                        <% } %>
                        <% if (newerRevisionId) { %>
                            <a href="/wiki/<%= title %>/diff?oldid=<%= newerRevisionId %>" class="btn btn-primary btn-flat text-sm px-3 py-1">Newer revision <i class="fas fa-arrow-right"></i></a>
                        <% } %>
                    </div>
                    <div class="wiki-rendered-content text-gray-900 leading-relaxed mb-4">
                        <%- oldRevision.content %>
                    </div>
                    <%- include('partials/categoryselect', { categories: pageCategories, showAddCategoryButton: false }) %>
                <% } %>
            </div>
            <%- include('./partials/footer') %>
        </div>
    </main>
    <script src="/js/scripts.js"></script>
</body>
</html>
