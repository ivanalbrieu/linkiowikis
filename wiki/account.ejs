<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentUser.username %> | Test Wiki | linkiowikis</title>
    <!-- Tailwind CSS -->
    <link href="/css/tailwind.css" rel="stylesheet">
    <link href="/css/all.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="shortcut icon" sizes="256x256" href="/img/favicon.ico" />
</head>
<body class="bg-black min-h-screen text-gray-900 font-sans m-0 p-0">
    <%- include('./partials/banner') %>
    <main class="w-full max-w-5xl mx-auto pt-20 pb-12 px-4">
        <%- include('./partials/addnewpage') %>
        <div class="bg-[#748a88] shadow-md">
            <%- include('./partials/header') %>
            <div class="bg-white min-h-[160px] p-6 shadow-sm">
                <!-- User Profile Header -->
                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-6">
                    <div class="flex-shrink-0">
                        <img src="<%= currentUser.avatar || '/img/avatars/default.jpg' %>" class="w-32 h-32 rounded-full border-2 border-gray-200 object-cover shadow-sm" alt="<%= currentUser.username %>">
                    </div>
                    <div class="flex-grow text-center sm:text-left">
                        <h2 class="text-2xl font-bold text-gray-900 m-0 mb-1"><%= currentUser.username %></h2>
                        <p class="text-gray-500 m-0 mb-2">Bio placeholder.</p>
                        <% if (currentUser.roles) { %>
                            <div class="flex flex-wrap gap-1 justify-center sm:justify-start">
                                <% currentUser.roles.forEach(function(role) { %>
                                    <span class="badge bg-primary"><%= role %></span>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <ul class="nav-tabs mb-6" id="userTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="profile-tab" href="/wiki/user/<%= currentUser.username %>" role="tab">Profile</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="messages-tab" href="/wiki/user/<%= currentUser.username %>/messages" role="tab">Message Wall</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="blog-tab" href="/wiki/user/<%= currentUser.username %>/blog" role="tab">Blog</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="contributions-tab" href="/wiki/contributions/<%= currentUser.username %>/" role="tab">Contributions</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="activity-tab" href="/wiki/socialactivity/<%= currentUser.username %>/" role="tab">Activity</a>
                    </li>
                </ul>

                <!-- Account Edit Form -->
                <form method="POST" action="/wiki/account" enctype="multipart/form-data" class="space-y-4 max-w-2xl">
                    <div class="form-group">
                        <label for="picture" class="block font-medium mb-1 text-sm">Avatar</label>
                        <input type="file" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer" id="picture" name="picture">
                        <% if (errors.picture) { %>
                            <% errors.picture.forEach(function(error) { %>
                                <div class="text-danger text-sm mt-1"><%= error %></div>
                            <% }); %>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="defaultAvatar" name="defaultAvatar">
                            <label class="form-check-label" for="defaultAvatar">
                                Revert to default avatar
                            </label>
                        </div>
                    </div>                            
                    <div class="form-group">
                        <label for="username" class="block font-medium mb-1 text-sm">Username</label>
                        <input type="text" class="form-control <%= errors.username ? 'is-invalid' : '' %>" id="username" name="username" value="<%= currentUser.username %>" required>
                        <% if (errors.username) { %>
                            <div class="invalid-feedback">
                                <% errors.username.forEach(function(error) { %>
                                    <%= error %>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label for="email" class="block font-medium mb-1 text-sm">Email</label>
                        <input type="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" value="<%= currentUser.email %>" required>
                        <% if (errors.email) { %>
                            <div class="invalid-feedback">
                                <% errors.email.forEach(function(error) { %>
                                    <%= error %>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label for="signature" class="block font-medium mb-1 text-sm">Signature</label>
                        <input type="text" class="form-control" id="signature" name="signature" value="<%= currentUser.signature %>" />
                        <small class="text-muted block mt-1">Comments on talk pages should be signed with "~~~~", which will be converted into your signature and a timestamp.</small>
                    </div>
                    <button type="submit" class="btn btn-primary btn-flat text-sm px-4 py-2">Save</button>
                </form>                        
            </div>
            <%- include('./partials/footer') %>
        </div>
    </main>
    <script src="/js/scripts.js"></script>
</body>
</html>
