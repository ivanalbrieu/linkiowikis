<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Your Site Name</title>
    <link href="/css/tailwind.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h2>Reset Password</h2>
        <% if (locals.success_msg && locals.success_msg.length > 0) { %>
            <% locals.success_msg.forEach(function(msg) { %>
                <div class="alert alert-success"><%= msg %></div>
            <% }); %>
        <% } %>        
        <form method="POST" action="/wiki/resetrequest">
            <% if (errors.email) { %>
                <div class="form-group">
                    <label for="email" class="form-control-label">Email</label>
                    <input type="email" class="form-control is-invalid" id="email" name="email" required>
                    <div class="invalid-feedback">  
                        <%= errors.email.msg %>
                    </div>
                </div>
            <% } else { %>
                <div class="form-group">
                    <label for="email" class="form-control-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
            <% } %>
            <button type="submit" class="btn btn-outline-info">Send Reset Link</button>
        </form>
    </div>
    </body>
</html>
