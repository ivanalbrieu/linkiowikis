<div class="flex items-center justify-between p-4 w-full bg-[#748a88]">
    <!-- Left side: Logo & Wiki Title / Subnav -->
    <div class="flex items-center gap-4">
        <a href="/wiki/" class="flex-shrink-0 block">
            <img src="/img/wikilogo.png" class="w-24 md:w-28 h-auto object-contain block" alt="Wiki Logo">
        </a>
        <div>
            <a href="/wiki/" class="no-underline text-black hover:no-underline">
                <h1 class="text-3xl font-medium text-black m-0 leading-tight"><%= siteConfig.wikiName %></h1>
            </a>
            <nav class="flex items-center gap-4 mt-1 text-sm">
                <a class="text-blue-600 hover:underline" href="/wiki/Main_Page">Main Page</a>
                <div class="relative dropdown">
                    <a class="text-blue-600 hover:underline cursor-pointer dropdown-toggle" id="headerMoreMenu" role="button">
                        More
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="headerMoreMenu">
                        <li><a class="dropdown-item" href="/wiki/Help">Help</a></li>
                        <li><a class="dropdown-item" href="/wiki/About">About</a></li>
                    </ul>
                </div>
            </nav>
        </div>
    </div>

    <!-- Right side: Page Counter & Add New Page Button -->
    <div class="flex items-center gap-4">
        <div class="text-right">
            <span class="text-2xl font-bold leading-none block text-black"><%= pagesCount %></span>
            <span class="text-xs text-gray-800">Pages</span>
        </div>
        <button class="btn btn-primary btn-flat text-sm px-3 py-1.5 flex items-center gap-2" type="button" data-bs-toggle="modal" data-bs-target="#addNewPageModal">
            <i class="fa-solid fa-file-circle-plus"></i> Add new page
        </button>
    </div>
</div>
